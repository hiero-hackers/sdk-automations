{
    "name": "@hiero-hackers/automation-runtime",
    "version": "0.0.0",
    "private": true,
    "description": "The running platform: `src/store/` is the owned operational store, `src/adapter/` the only place that talks to GitHub, and `src/shell/` the transport that composes them — the tree is design/architecture.md §1.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "test": "tsc --noEmit && vitest run",
        "test:coverage": "tsc --noEmit && vitest run --coverage --testTimeout=15000",
        "test:watch": "vitest",
        "start": "tsx src/shell/compose/main.ts",
        "explain": "tsx src/shell/observe/explain-cli.ts",
        "status": "tsx src/shell/observe/status-cli.ts"
    },
    "dependencies": {
        "@hiero-hackers/automation-capabilities": "workspace:*",
        "@hiero-hackers/automation-core": "workspace:*"
    },
    "devDependencies": {
        "@hiero-hackers/automation-testkit": "workspace:*",
        "@stryker-mutator/core": "^10.0.0",
        "@stryker-mutator/vitest-runner": "^10.0.0",
        "@types/node": "^24.13.6",
        "fast-check": "^4.10.2",
        "tsx": "^4.23.15",
        "typescript": "^5.6.0",
        "vitest": "^4.1.11"
    }
}
