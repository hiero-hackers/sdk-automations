{
    "revision": "inactivity.yml",
    "schemaVersion": 2,
    "mode": "dry-run",
    "capabilities": {
        "inactivity": {
            "enabled": true,
            "settings": {
                "exemptBlocked": true,
                "remindAfter": 720,
                "reap": {
                    "after": 1440
                },
                "issues": {
                    "enabled": true,
                    "remindAfter": 720,
                    "reap": {
                        "enabled": true,
                        "after": 1440
                    }
                },
                "pullRequests": {
                    "enabled": true,
                    "remindAfter": 720,
                    "reap": {
                        "after": 1440
                    },
                    "reapWhen": {
                        "draft": {
                            "enabled": true,
                            "remindAfter": 720,
                            "reap": {
                                "enabled": true,
                                "after": 1440
                            }
                        },
                        "changesRequested": {
                            "enabled": false
                        },
                        "needsRevision": {
                            "enabled": false
                        }
                    }
                }
            }
        }
    },
    "mappings": {
        "labels": {
            "awaitingTriage": "status: triage",
            "ready": "status: ready",
            "inProgress": "status: in progress",
            "needsReview": "status: needs review",
            "needsRevision": "status: needs revision",
            "readyToMerge": "status: ready to merge",
            "blocked": "status: blocked"
        },
        "commands": {
            "working": "/working"
        },
        "skills": {},
        "alerts": {}
    },
    "principals": {}
}
