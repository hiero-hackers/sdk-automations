{
    "name": "@hiero-hackers/automation-checks",
    "version": "0.0.0",
    "private": true,
    "description": "Tests about the REPOSITORY, not about any package: docs and examples stay true to core's vocabularies, design diagrams match the edge tables, artifacts hold their invariants. No src/ — nothing here can or should kill a mutant. Depends on core only through its public barrel.",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "test": "tsc --noEmit && vitest run",
        "test:watch": "vitest",
        "generate": "tsc --noEmit && tsx test/generate.ts"
    },
    "devDependencies": {
        "@hiero-hackers/automation-capabilities": "workspace:*",
        "@hiero-hackers/automation-core": "workspace:*",
        "@hiero-hackers/automation-testkit": "workspace:*",
        "@types/node": "^24.13.4",
        "ajv": "8.20.0",
        "dependency-cruiser": "^18.2.0",
        "jsdom": "^25.0.1",
        "mermaid": "^11.17.2",
        "tsx": "^4.23.13",
        "typescript": "^5.6.0",
        "vitest": "^4.1.11",
        "yaml": "^2.9.0"
    }
}
