{
    "name": "@hiero-hackers/automation-store",
    "version": "0.0.0",
    "private": true,
    "description": "The owned operational store: five tables in one versioned SQLite file for durable delivery intake, canonical reports, effect journaling and claims, and schedules. The recovery model is pending stage-four ratification.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "test": "tsc --noEmit && vitest run",
        "test:coverage": "tsc --noEmit && vitest run --coverage --testTimeout=15000",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@hiero-hackers/automation-core": "workspace:*"
    },
    "devDependencies": {
        "@hiero-hackers/automation-testkit": "workspace:*",
        "@stryker-mutator/core": "^10.0.0",
        "@stryker-mutator/vitest-runner": "^9.6.1",
        "@types/node": "^24.0.0",
        "fast-check": "^4.9.0",
        "typescript": "^5.6.0",
        "vitest": "^4.0.0"
    }
}
