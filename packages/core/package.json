{
    "name": "@hiero-hackers/automation-core",
    "version": "0.0.0",
    "private": true,
    "description": "Pure-logic core of the maintainer-automation platform: workflow state machine, safety engine, configuration validation. No I/O, no GitHub — see design/architecture.md.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./author": {
            "types": "./src/author/index.ts",
            "default": "./src/author/index.ts"
        },
        "./author/testing": {
            "types": "./src/author/testing.ts",
            "default": "./src/author/testing.ts"
        }
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "test": "tsc --noEmit && vitest run",
        "test:watch": "vitest",
        "test:coverage": "tsc --noEmit && vitest run --coverage --testTimeout=15000"
    },
    "devDependencies": {
        "@hiero-hackers/automation-testkit": "workspace:*",
        "@stryker-mutator/core": "^10.0.0",
        "@stryker-mutator/vitest-runner": "^10.0.0",
        "@types/node": "^24.13.4",
        "fast-check": "^4.10.0",
        "typescript": "^5.6.0",
        "vitest": "^5.0.0"
    },
    "dependencies": {
        "yaml": "^2.9.0"
    }
}
