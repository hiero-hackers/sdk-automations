{
    "name": "@hiero-hackers/automation-shell",
    "version": "0.0.0",
    "private": true,
    "description": "The transport shell: webhook in → verify → durably accept → 202 → mode check → persisted outcome. Owns ordering, decides nothing — see README.md and D93.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "test": "tsc --noEmit && vitest run",
        "test:watch": "vitest",
        "start": "tsx src/main.ts"
    },
    "dependencies": {
        "@hiero-hackers/automation-core": "workspace:*",
        "@hiero-hackers/automation-probes": "workspace:*",
        "@hiero-hackers/automation-store": "workspace:*"
    },
    "devDependencies": {
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/vitest-runner": "^9.6.1",
        "@types/node": "^24.0.0",
        "tsx": "^4.23.11",
        "typescript": "^5.6.0",
        "vitest": "^4.0.0"
    }
}
