{
    "name": "@hiero-hackers/automation-capabilities",
    "version": "0.0.0",
    "private": true,
    "description": "The capabilities the runtime's shell composes; one folder per capability, registered in `src/index.ts`. See README.md.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "test": "tsc --noEmit && vitest run",
        "test:coverage": "tsc --noEmit && vitest run --coverage --testTimeout=15000",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@hiero-hackers/automation-core": "workspace:*"
    },
    "devDependencies": {
        "@stryker-mutator/core": "^10.0.0",
        "@stryker-mutator/vitest-runner": "^10.0.0",
        "@types/node": "^24.13.4",
        "typescript": "^5.6.0",
        "vitest": "^5.0.0"
    }
}
