{
    "name": "@hiero-hackers/sdk-automations",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@10.29.1",
    "description": "Workspace root — see README.md. Implementation packages: core (pure logic), runtime (the owned operational store, the GitHub adapter and the transport shell), capabilities (the capabilities the shell composes).",
    "scripts": {
        "test": "pnpm -r test",
        "test:packages": "pnpm -r --filter='!@hiero-hackers/automation-checks' --filter='!{.}' test",
        "test:repo": "pnpm --filter @hiero-hackers/automation-checks test",
        "test:coverage": "pnpm -r test:coverage",
        "contracts": "pnpm --filter @hiero-hackers/automation-checks generate",
        "lint": "eslint .",
        "audit": "pnpm audit --audit-level moderate",
        "format": "prettier --write \"packages/**/*.ts\"",
        "format:check": "prettier --check \"packages/**/*.ts\""
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.10.0",
        "prettier": "^3.9.6",
        "typescript-eslint": "^8.70.0"
    },
    "pnpm": {
        "overrides": {
            "brace-expansion@<5.0.9": ">=5.0.9",
            "fast-uri@<4.1.3": ">=4.1.3",
            "nanoid@<3.3.17": ">=3.3.17 <4",
            "qs@<6.16.0": ">=6.16.0"
        }
    }
}
